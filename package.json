{
    "name": "browser-assistant",
    "apiVersion": "1",
    "description": "AdGuard browser extension",
    "author": "adguard@adguard.com",
    "license": "LGPL-3.0",
    "scripts": {
        "lint": "pnpm lint:code && pnpm lint:types",
        "lint:code": "eslint --cache . --ext .ts,.tsx,.js",
        "lint:types": "tsc --noEmit",
        "dev": "cross-env BUILD_ENV=dev ts-node scripts/bundle",
        "beta": "cross-env BUILD_ENV=beta ts-node scripts/bundle",
        "release": "cross-env BUILD_ENV=release ts-node scripts/bundle",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "locales": "ts-node scripts/translations",
        "crx": "ts-node scripts/crx.ts",
        "update-json": "ts-node scripts/update-json.ts",
        "artifacts:beta": "export BUILD_ENV=beta; pnpm beta && pnpm crx",
        "artifacts:beta-firefox": "export BUILD_ENV=beta; pnpm beta firefox && pnpm update-json",
        "artifacts:release": "export BUILD_ENV=release; pnpm release && pnpm crx"
    },
    "husky": {
        "hooks": {
            "pre-commit": "pnpm lint",
            "pre-push": "pnpm test"
        }
    },
    "dependencies": {
        "@adguard/assistant": "^4.4.3",
        "@adguard/translate": "^0.2.5",
        "classnames": "^2.3.1",
        "compare-versions": "^4.1.3",
        "lodash": "^4.17.21",
        "mobx": "^6.3.7",
        "mobx-react": "7.2.1",
        "nanoid": "^4.0.0",
        "react": "16.13.0",
        "react-dom": "16.13.0",
        "react-intl": "3.12.0",
        "react-modal": "3.11.2",
        "webextension-polyfill": "^0.6.0"
    },
    "devDependencies": {
        "@rspack/core": "2.1.5",
        "@types/archiver": "^8.0.0",
        "@types/chrome": "^0.0.193",
        "@types/lodash": "4.17.24",
        "@types/nanoid": "^3.0.0",
        "@types/node": "^18.7.6",
        "@types/react": "^19.1.1",
        "@types/react-modal": "3.16.3",
        "@types/webextension-polyfill": "^0.9.0",
        "@typescript-eslint/eslint-plugin": "5.62.0",
        "@typescript-eslint/parser": "5.62.0",
        "archiver": "^8.0.0",
        "axios": "^1.15.0",
        "chalk": "^4.1.0",
        "commander": "^6.1.0",
        "cross-env": "^7.0.3",
        "crx": "^5.0.1",
        "css-loader": "^3.4.2",
        "eslint": "8.57.1",
        "eslint-config-airbnb": "19.0.4",
        "eslint-config-airbnb-typescript": "^17.0.0",
        "eslint-import-resolver-typescript": "^3.6.1",
        "eslint-plugin-import": "^2.29.0",
        "eslint-plugin-import-newlines": "1.4.0",
        "eslint-plugin-jsdoc": "63.2.2",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "4.6.0",
        "form-data": "^3.0.0",
        "husky": "^4.3.0",
        "npm-run-all": "^4.1.5",
        "postcss-import": "^12.0.1",
        "postcss-loader": "^3.0.0",
        "postcss-nested": "^4.2.1",
        "postcss-preset-env": "^6.7.0",
        "postcss-svg": "^3.0.0",
        "string-replace-loader": "^3.1.0",
        "style-loader": "^1.1.3",
        "ts-node": "^10.9.1",
        "typescript": "5.9.3",
        "vitest": "4.1.10"
    }
}
