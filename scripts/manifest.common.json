{
    "manifest_version": 3,
    "name": "__MSG_name__",
    "author": "Adguard Software Ltd",
    "version": "__version__",
    "description": "__MSG_description__",
    "icons": {
        "16": "assets/images/icons/green-16.png",
        "48": "assets/images/icons/green-48.png",
        "128": "assets/images/icons/green-128.png"
    },
    "action": {
        "default_icon": {
            "19": "assets/images/icons/green-19.png",
            "38": "assets/images/icons/green-38.png"
        },
        "default_title": "__MSG_name__",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "options_ui": {
        "page": "options-ui.html",
        "browser_style": true
    },
    "content_scripts": [
        {
            "js": ["keep-awake.js"],
            "run_at": "document_start",
            "matches": [
                "*://*/*"
            ]
        }
    ],
    "permissions": [
        "nativeMessaging",
        "tabs",
        "activeTab",
        "contextMenus",
        "storage"
    ]
}
